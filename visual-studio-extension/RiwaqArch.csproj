<Project Sdk="MSBuild.Sdk.VisualStudio.ProjectConfiguration">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>RiwaqArch</RootNamespace>
    <AssemblyName>RiwaqArch</AssemblyName>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <VSSDKTargetPlatformVersion>v17</VSSDKTargetPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.31912.275" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.0.5232" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\preview.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\vscode-extension\bin\riwaq.exe">
      <Link>bin\riwaq.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <Target Name="CopyRiwaqBinary" BeforeTargets="Build">
    <PropertyGroup>
      <RiwaqSourcePath>$(ProjectDir)..\vscode-extension\bin\riwaq.exe</RiwaqSourcePath>
      <RiwaqDestPath>$(ProjectDir)bin\riwaq.exe</RiwaqDestPath>
    </PropertyGroup>
    <Copy SourceFiles="$(RiwaqSourcePath)" DestinationFiles="$(RiwaqDestPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
