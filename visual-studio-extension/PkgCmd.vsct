<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="GuidRiwaqArchPkg">
    <Menus>
      <Menu Guid="guidRiwaqArchCmdSet" id="TopLevelMenu" priority="0x100" type="Menu">
        <Parent Guid="guidSHLMainMenu" id="IDG_VS_TOOLS"/>
        <Strings>
          <ButtonText>Riwaq Arch</ButtonText>
          <CommandName>TopLevelMenu</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group Guid="guidRiwaqArchCmdSet" id="MainGroup" priority="0x0000">
        <Parent Guid="guidRiwaqArchCmdSet" id="TopLevelMenu"/>
      </Group>
    </Groups>

    <Buttons>
      <!-- Analyze Project -->
      <Button Guid="guidRiwaqArchCmdSet" id="cmdidAnalyzeProject" priority="0x0100" type="Button">
        <Parent Guid="guidRiwaqArchCmdSet" id="MainGroup"/>
        <Icon Guid="guidImages" id="bmpPic1"/>
        <Strings>
          <ButtonText>Analyze Project</ButtonText>
          <ToolTipText>Analyze the current project with Riwaq</ToolTipText>
        </Strings>
      </Button>

      <!-- Start Server -->
      <Button Guid="guidRiwaqArchCmdSet" id="cmdidStartServer" priority="0x0101" type="Button">
        <Parent Guid="guidRiwaqArchCmdSet" id="MainGroup"/>
        <Strings>
          <ButtonText>Start Server</ButtonText>
          <ToolTipText>Start the Riwaq analysis server</ToolTipText>
        </Strings>
      </Button>

      <!-- Stop Server -->
      <Button Guid="guidRiwaqArchCmdSet" id="cmdidStopServer" priority="0x0102" type="Button">
        <Parent Guid="guidRiwaqArchCmdSet" id="MainGroup"/>
        <Strings>
          <ButtonText>Stop Server</ButtonText>
          <ToolTipText>Stop the Riwaq analysis server</ToolTipText>
        </Strings>
      </Button>

      <!-- Generate Docs -->
      <Button Guid="guidRiwaqArchCmdSet" id="cmdidGenerateDocs" priority="0x0103" type="Button">
        <Parent Guid="guidRiwaqArchCmdSet" id="MainGroup"/>
        <Strings>
          <ButtonText>Generate Documentation</ButtonText>
          <ToolTipText>Generate BRD, SRS and API Reference</ToolTipText>
        </Strings>
      </Button>
    </Buttons>

    <Bitmaps>
      <Bitmap Guid="guidImages" href="Resources\Images.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicArrows, bmpPicStrikethrough"/>
    </Bitmaps>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidRiwaqArchPkg" value="{xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}">
      <IDSymbol name="TopLevelMenu" value="0x1000"/>
      <IDSymbol name="MainGroup" value="0x1001"/>
    </GuidSymbol>

    <GuidSymbol name="guidRiwaqArchCmdSet" value="{xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}">
      <IDSymbol name="cmdidAnalyzeProject" value="0x0100"/>
      <IDSymbol name="cmdidStartServer" value="0x0101"/>
      <IDSymbol name="cmdidStopServer" value="0x0102"/>
      <IDSymbol name="cmdidGenerateDocs" value="0x0106"/>
    </GuidSymbol>

    <GuidSymbol name="guidImages" value="{xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}">
      <IDSymbol name="bmpPic1" value="1"/>
      <IDSymbol name="bmpPic2" value="2"/>
      <IDSymbol name="bmpPicSearch" value="3"/>
      <IDSymbol name="bmpPicArrows" value="4"/>
      <IDSymbol name="bmpPicStrikethrough" value="5"/>
    </GuidSymbol>
  </Symbols>
</CommandTable>
